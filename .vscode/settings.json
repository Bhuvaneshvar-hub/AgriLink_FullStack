{
  // The backend is a multi-module Maven project rooted at backend/pom.xml.
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.maven.enabled": true,

  // Lombok is used across every service (@Data, @Builder, @Slf4j, etc.).
  // Without this, the language server can't see the generated getters/
  // setters/builders and reports hundreds of phantom "cannot resolve" errors,
  // even though Maven compiles cleanly.
  "java.jdt.ls.lombokSupport.enabled": true,

  // Project targets Java 17; build/tests were verified on this JDK 21 install.
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "C:\\Program Files\\Java\\jdk-21",
      "default": true
    }
  ],

  // Keep the language server from indexing build output / deps.
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.git/**",
    "**/target/**"
  ],
  // Disabled deliberately. With "automatic", JDT turns on annotation-based null
  // analysis, which floods the Problems panel with ~45 "Null type safety:
  // parameter 'this' provided via method descriptor ..." warnings on ordinary
  // method references (CropPlan::getPlanId, ProduceSale::getTotalAmount, the
  // Spring Security csrf disable lambda, ...). Those are false positives: they
  // fire because the JDK functional interfaces and Spring's APIs carry no null
  // annotations of their own, not because anything can actually NPE. The project
  // doesn't use JSR-305/JDT null annotations, so the analysis has nothing real
  // to check and only hides genuine warnings in the noise.
  "java.compile.nullAnalysis.mode": "disabled"
}
