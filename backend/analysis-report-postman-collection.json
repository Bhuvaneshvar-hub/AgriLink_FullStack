{
	"info": {
		"_postman_id": "c1a052b3-5fa8-4b72-a7d2-1be812d4fae7",
		"name": "AgriLink - Analytics and Report Service",
		"description": "Collection of all 20 Analytics and Report Service endpoints including dashboard metrics, reports, farmers statistics, subsidy analysis, and produce metrics, routed via the API Gateway.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login successful\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set(\"token\", jsonData.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@agrilink.com\",\n  \"password\": \"Admin@1234\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/agriLink/session/login",
						"description": "Authenticate admin user and store the Bearer token in the collection variable `token` for downstream request auth."
					},
					"response": []
				}
			]
		},
