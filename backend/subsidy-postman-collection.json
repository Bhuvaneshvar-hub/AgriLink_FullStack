{
	"info": {
		"_postman_id": "b3e042b3-5fa8-4b72-a7d2-1be812d4fae6",
		"name": "AgriLink - Subsidy Scheme Service",
		"description": "Collection of all 14 Subsidy Scheme Service endpoints including government scheme management and subsidy applications workflow, routed via the API Gateway.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login successful\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set(\"token\", jsonData.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@agrilink.com\",\n  \"password\": \"Admin@1234\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/agriLink/session/login",
						"description": "Authenticate user and automatically store the JWT Bearer Token into the collection variable `token` for subsequent requests."
					},
					"response": []
				}
			]
		},
